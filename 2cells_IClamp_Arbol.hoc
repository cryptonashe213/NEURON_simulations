// ============================================================
// 2cells_IClamp_TreeDend_naxkdr.hoc
// ------------------------------------------------------------
// Misma morfologia que 2cells_NetStim_TreeDend_naxkdr.hoc:
//   - 1 soma
//   - 1 dendrita principal
//   - 2 dendritas laterales (HI a 0.7 del principal, LO a 0.5)
//
// El IClamp se inyecta en una DENDRITA (no en soma), siguiendo
// la peticion de la reunion. Por defecto en la dendrita lateral
// alta (latHI), pero se puede cambiar con IC_LOC y IC_POS.
// La inhibicion reciproca sigue siendo perisomatica.
// ============================================================
load_file("nrngui.hoc")

// ============================================================
// ESTRUCTURA: soma[2] + dendritas
// ============================================================
create soma[2]
create main_0,  main_1
create latHI_0, latHI_1
create latLO_0, latLO_1

// ----------------------------------------------------------
// Geometria 3D explicita (laterales con ANGULO respecto al principal)
// ----------------------------------------------------------
PI_LOCAL  = 3.14159265358979
cell_dx   = 60
DIAM_SOMA = 20
DIAM_MAIN = 2.0
DIAM_LAT  = 1.0
L_MAIN    = 200
L_LAT     = 50
P_LATHI   = 0.7
P_LATLO   = 0.5
ALPHA_DEG = 45
ALPHA_RAD = ALPHA_DEG * PI_LOCAL / 180

xc0 = -cell_dx/2
xc1 =  cell_dx/2
y_HI_pos = P_LATHI * L_MAIN
y_LO_pos = P_LATLO * L_MAIN
dx_lat   = L_LAT * sin(ALPHA_RAD)
dy_lat   = L_LAT * cos(ALPHA_RAD)

soma[0] { pt3dclear()
    pt3dadd(xc0 - DIAM_SOMA/2, 0, 0, DIAM_SOMA)
    pt3dadd(xc0 + DIAM_SOMA/2, 0, 0, DIAM_SOMA)
}
soma[1] { pt3dclear()
    pt3dadd(xc1 - DIAM_SOMA/2, 0, 0, DIAM_SOMA)
    pt3dadd(xc1 + DIAM_SOMA/2, 0, 0, DIAM_SOMA)
}
main_0 { pt3dclear()  nseg=11  Ra=100  cm=1
    pt3dadd(xc0, 0,      0, DIAM_MAIN)
    pt3dadd(xc0, L_MAIN, 0, DIAM_MAIN)
}
main_1 { pt3dclear()  nseg=11  Ra=100  cm=1
    pt3dadd(xc1, 0,      0, DIAM_MAIN)
    pt3dadd(xc1, L_MAIN, 0, DIAM_MAIN)
}
latHI_0 { pt3dclear()  nseg=5  Ra=100  cm=1
    pt3dadd(xc0,            y_HI_pos,            0, DIAM_LAT)
    pt3dadd(xc0 + dx_lat,   y_HI_pos + dy_lat,   0, DIAM_LAT)
}
latHI_1 { pt3dclear()  nseg=5  Ra=100  cm=1
    pt3dadd(xc1,            y_HI_pos,            0, DIAM_LAT)
    pt3dadd(xc1 + dx_lat,   y_HI_pos + dy_lat,   0, DIAM_LAT)
}
latLO_0 { pt3dclear()  nseg=5  Ra=100  cm=1
    pt3dadd(xc0,            y_LO_pos,            0, DIAM_LAT)
    pt3dadd(xc0 - dx_lat,   y_LO_pos + dy_lat,   0, DIAM_LAT)
}
latLO_1 { pt3dclear()  nseg=5  Ra=100  cm=1
    pt3dadd(xc1,            y_LO_pos,            0, DIAM_LAT)
    pt3dadd(xc1 - dx_lat,   y_LO_pos + dy_lat,   0, DIAM_LAT)
}

// Conexiones topologicas
connect main_0(0),  soma[0](0.5)
connect latHI_0(0), main_0(P_LATHI)
connect latLO_0(0), main_0(P_LATLO)
connect main_1(0),  soma[1](0.5)
connect latHI_1(0), main_1(P_LATHI)
connect latLO_1(0), main_1(P_LATLO)

// ============================================================
// Canales (identicos al BS4 / simple)
// ============================================================
forall insert pas
forall insert kdr
forall insert nax
forall g_pas       = 0.0001
forall e_pas       = -65
forall ena         = 55
forall ek          = -90
forall gbar_nax    = 0.04
forall gkdrbar_kdr = 0.04

celsius = 34
PI      = 3.14159265358979

// ============================================================
// PARAMETROS GLOBALES
// ============================================================
iamp     = 1.0
iampfact = 1
wi       = 5e-4
Idel     = 30
N        = 2
t_therm  = 200

// Localizacion del IClamp:
//   1 = latHI (lateral alta)
//   2 = latLO (lateral baja)
//   3 = main (dendrita principal, en posicion IC_POS)
//   4 = soma (referencia, comparar con BS4)
IC_LOC = 1
IC_POS = 0.5      // posicion dentro de la seccion elegida

// ============================================================
// Objetos
// ============================================================
objref fv, corr_out
objref syni[2], nci[2], ic[2]
objref phi[2]
objref ispk, tspkprec, tspknext, ph
objref spike_times[2], spike_rec[2], vvec[2], tvec
objref nullobj
strdef new_file
fv = new File()

// ============================================================
// SINAPSIS INHIBITORIA (perisomatica, igual que siempre)
// y registro de spikes
// ============================================================
for k = 0, 1 {
    soma[k] {
        syni[k]     = new ExpSyn(0.5)
        syni[k].tau = 30
        syni[k].e   = -80
        spike_times[k] = new Vector()
        spike_rec[k]   = new NetCon(&v(0.5), nullobj, 0, 0, 0)
        spike_rec[k].record(spike_times[k])
    }
}
soma[0] nci[0] = new NetCon(&v(.5), syni[1], 0, 0, wi)
soma[1] nci[1] = new NetCon(&v(.5), syni[0], 0, 0, wi)

// ============================================================
// IClamp en DENDRITA (o soma) segun IC_LOC
// ============================================================
if (IC_LOC == 1) {
    latHI_0 { ic[0] = new IClamp(IC_POS)  ic[0].amp=0  ic[0].dur=0  ic[0].del=0 }
    latHI_1 { ic[1] = new IClamp(IC_POS)  ic[1].amp=0  ic[1].dur=0  ic[1].del=0 }
    print "IClamp en latHI a posicion ", IC_POS
} else if (IC_LOC == 2) {
    latLO_0 { ic[0] = new IClamp(IC_POS)  ic[0].amp=0  ic[0].dur=0  ic[0].del=0 }
    latLO_1 { ic[1] = new IClamp(IC_POS)  ic[1].amp=0  ic[1].dur=0  ic[1].del=0 }
    print "IClamp en latLO a posicion ", IC_POS
} else if (IC_LOC == 3) {
    main_0 { ic[0] = new IClamp(IC_POS)  ic[0].amp=0  ic[0].dur=0  ic[0].del=0 }
    main_1 { ic[1] = new IClamp(IC_POS)  ic[1].amp=0  ic[1].dur=0  ic[1].del=0 }
    print "IClamp en dendrita PRINCIPAL a posicion ", IC_POS
} else {
    soma[0] { ic[0] = new IClamp(0.5)  ic[0].amp=0  ic[0].dur=0  ic[0].del=0 }
    soma[1] { ic[1] = new IClamp(0.5)  ic[1].amp=0  ic[1].dur=0  ic[1].del=0 }
    print "IClamp en SOMA (referencia)"
}

print "============================================="
print "  TreeDend IClamp (soma + main + 2 laterales)"
print "  IC_LOC=", IC_LOC, " IC_POS=", IC_POS, " Idel=", Idel
print "============================================="

// ============================================================
// advance()
// ============================================================
proc advance() {
    fadvance()
    if (fv.isopen()) {
        fv.printf("%g %g %g\n", t, soma[0].v(0.5), soma[1].v(0.5))
    }
}

// ============================================================
// run_sim_clean()
// ============================================================
func run_sim_clean() { local k, min_spk, first_valid, t_idx
    if (fv.isopen()) { fv.close() }
    ic[0].amp = iamp
    ic[0].del = 0
    ic[0].dur = t_therm + tstop_diag
    ic[1].amp = iamp * iampfact
    ic[1].del = Idel
    ic[1].dur = t_therm + tstop_diag

    soma[0] nci[0] = new NetCon(&v(.5), syni[1], 0, 0, wi)
    soma[1] nci[1] = new NetCon(&v(.5), syni[0], 0, 0, wi)

    tvec = new Vector()
    tvec.record(&t)
    for k = 0, 1 {
        spike_times[k] = new Vector()
        vvec[k]        = new Vector()
        soma[k] {
            vvec[k].record(&v(0.5))
            spike_rec[k] = new NetCon(&v(0.5), nullobj, 0, 0, 0)
            spike_rec[k].record(spike_times[k])
        }
    }
    finitialize(-65)
    tstop = t_therm + tstop_diag
    run()
    t_idx = tvec.indwhere(">=", t_therm)
    if (t_idx > 0) {
        tvec.remove(0, t_idx - 1)
        for k = 0, 1 { vvec[k].remove(0, t_idx - 1) }
    }
    for k = 0, 1 {
        first_valid = spike_times[k].indwhere(">=", t_therm)
        if (first_valid > 0) {
            spike_times[k].remove(0, first_valid - 1)
        } else if (first_valid < 0) {
            spike_times[k].resize(0)
        }
    }
    min_spk = spike_times[0].size()
    if (spike_times[1].size() < min_spk) { min_spk = spike_times[1].size() }
    return min_spk
}

// ============================================================
// calc_phase, calc_corr, calc_corr_2_N (identicos)
// ============================================================
proc calc_phase() { local k, i, j, t_curr, t_prev, t_next
    for k = 0, 1 {
        phi[k] = new Vector(tvec.size())
        phi[k].fill(-1)
        for j = 0, tvec.size()-1 {
            t_curr = tvec.x[j]
            for i = 0, spike_times[k].size()-2 {
                if (t_curr >= spike_times[k].x[i] && t_curr < spike_times[k].x[i+1]) {
                    t_prev = spike_times[k].x[i]
                    t_next = spike_times[k].x[i+1]
                    phi[k].x[j] = 2*PI * (t_curr - t_prev) / (t_next - t_prev)
                }
            }
        }
    }
}

func calc_corr() { local j, tin_idx, tfin_idx, sum, dt, t_range, dphi
    tin_idx  = tvec.indwhere(">=", spike_times[0].x[1])
    tfin_idx = tvec.indwhere(">=", spike_times[0].x[spike_times[0].size()-2])
    if (tin_idx  < 0) { tin_idx  = 0 }
    if (tfin_idx < 0) { tfin_idx = tvec.size()-1 }
    t_range = tvec.x[tfin_idx] - tvec.x[tin_idx]
    if (t_range <= 0) { return -9999 }
    sum = 0
    dt  = tvec.x[1] - tvec.x[0]
    for j = tin_idx, tfin_idx-1 {
        if (phi[0].x[j] >= 0 && phi[1].x[j] >= 0) {
            dphi = phi[1].x[j] - phi[0].x[j]
            sum  = sum + cos(dphi) * dt
        }
    }
    return sum / t_range
}

func calc_corr_2_N() { local l, tmax, ttt, ddt, cs_med, t_range
    ispk = new Vector(N)  tspkprec = new Vector(N)  tspknext = new Vector(N)  ph = new Vector(N)
    tmax = spike_times[0].x[spike_times[0].size()-1]
    for l = 1, N-1 {
        if (spike_times[l].x[spike_times[l].size()-1] < tmax) {
            tmax = spike_times[l].x[spike_times[l].size()-1]
        }
    }
    ddt = 0.1
    for l = 0, N-1 {
        ispk.x[l] = 0
        tspkprec.x[l] = spike_times[l].x[0]
        tspknext.x[l] = spike_times[l].x[1]
        ph.x[l] = 0
    }
    cs_med = 0
    ttt = tvec.x[0]
    while (ttt < tmax) {
        for l = 0, N-1 {
            if (spike_times[l].size() > 1) {
                if (ttt >= tspknext.x[l]) {
                    if (ispk.x[l] + 1 < spike_times[l].size() - 1) {
                        ispk.x[l] += 1
                        tspkprec.x[l] = spike_times[l].x[ispk.x[l]]
                        tspknext.x[l] = spike_times[l].x[ispk.x[l] + 1]
                    }
                }
                if (tspkprec.x[l] != tspknext.x[l] && ttt < tspknext.x[l]) {
                    ph.x[l] = 2*PI * (ttt - tspkprec.x[l]) / (tspknext.x[l] - tspkprec.x[l])
                }
            }
        }
        cs_med += cos(ph.x[1] - ph.x[0]) * ddt
        ttt += ddt
    }
    t_range = ttt - tvec.x[0]
    if (t_range <= 0) { return -9999 }
    return cs_med / t_range
}
// ============================================================
// snippet_freq_test_TreeDend_IClamp.hoc
// ------------------------------------------------------------
// PEGAR al final de 2cells_IClamp_TreeDend_naxkdr.hoc,
// antes de la llamada a phase_diagram_compare().
//
// Contiene:
//   - test_iamp_por_regimen() : barre iamp y reporta cuando dispara
//   - freq_diagram()           : barre (iamp, wi) y guarda f_in y f_out
// ============================================================

// ============================================================
// test_iamp_por_regimen()
// ============================================================
proc test_iamp_por_regimen() { local iamp_test, spk, cval, c2val, \
                                    f_out_0, f_out_1, ratio, \
                                    iamp_min_fire, iamp_max_fire
    print "=== TEST iamp por regimen (TreeDend IClamp) ==="
    print "IC_LOC=", IC_LOC, "  IC_POS=", IC_POS, " (1=latHI, 2=latLO, 3=main, 4=soma)"
    print "wi=0, Idel=", Idel, " ms"
    print ""
    tstop_diag = 2000
    wi = 0
    iamp_min_fire = -1
    iamp_max_fire = -1
    iamp_test = 0.02
    while (iamp_test <= 2.0 + 1e-8) {
        iamp = iamp_test
        spk = run_sim_clean()
        f_out_0 = 0  f_out_1 = 0
        if (spike_times[0].size() >= 2) {
            f_out_0 = (spike_times[0].size()-1) \
                    / (spike_times[0].x[spike_times[0].size()-1] \
                       - spike_times[0].x[0]) * 1000
        }
        if (spike_times[1].size() >= 2) {
            f_out_1 = (spike_times[1].size()-1) \
                    / (spike_times[1].x[spike_times[1].size()-1] \
                       - spike_times[1].x[0]) * 1000
        }
        if (spk >= 5) {
            calc_phase()
            cval  = calc_corr()
            c2val = calc_corr_2_N()
            printf("  iamp=%.3f  spk0=%3d  spk1=%3d  f0=%6.2f  f1=%6.2f  C1=%6.3f  C2N=%6.3f", \
                iamp_test, spike_times[0].size(), spike_times[1].size(), \
                f_out_0, f_out_1, cval, c2val)
            if (f_out_0 > 0 && f_out_1 > 0) {
                ratio = f_out_0 / f_out_1
                if (ratio < 1) { ratio = 1/ratio }
                if (ratio > 1.2) {
                    printf("  (ASIMETRICO)\n")
                } else {
                    printf("  (FIRING)\n")
                }
                if (iamp_min_fire < 0) { iamp_min_fire = iamp_test }
                iamp_max_fire = iamp_test
            } else {
                printf("  (UNA SOLA?)\n")
            }
        } else {
            if (spike_times[0].size() == 0 && spike_times[1].size() == 0) {
                if (iamp_min_fire > 0) {
                    printf("  iamp=%.3f  spk=0/0  (BLOQUE?)\n", iamp_test)
                } else {
                    printf("  iamp=%.3f  spk=0/0  (SILENCIO)\n", iamp_test)
                }
            } else {
                printf("  iamp=%.3f  spk=%d/%d  (pocos spikes)\n", \
                    iamp_test, spike_times[0].size(), spike_times[1].size())
            }
        }
        if (iamp_test < 0.2) {
            iamp_test += 0.02
        } else if (iamp_test < 0.5) {
            iamp_test += 0.05
        } else {
            iamp_test += 0.1
        }
    }
    print ""
    print "=== RESUMEN ==="
    if (iamp_min_fire > 0) {
        printf("  iamp_min con spikes: %.3f nA\n", iamp_min_fire)
        printf("  iamp_max con spikes: %.3f nA\n", iamp_max_fire)
        printf("  RANGO UTIL: [%.3f, %.3f] nA\n", iamp_min_fire, iamp_max_fire)
    } else {
        print "  NUNCA hubo spikes. Sube el rango o cambia IC_LOC."
    }
    tstop_diag = 2000
}

// ============================================================
// freq_diagram(): barrido (iamp, wi) -> f_in y f_out
// ============================================================
proc freq_diagram() { local wi_val, iamp_val, min_spk, \
                           f_in_0, f_in_1, f_out_0, f_out_1
    iamp_min   = 0.1
	iamp_max   = 2.0
	iamp_step  = 0.1           // 36 iamps
	wi_min     = 0
	wi_max     = 5e-3           // ¡10× mas alto!
	wi_step    = 1e-4           // 50 wi
	tstop_diag = 2000
	Idel       = 30

    sprint(new_file, "FreqIn_vs_FreqOut_TreeDend_IClamp_IC_LOC%d_ICPOS%g_Idel%g_therm%d_MAYORWI.txt", \
           IC_LOC, IC_POS, Idel, t_therm)
    corr_out = new File()
    corr_out.wopen(new_file)
    corr_out.printf("# TreeDend IClamp IC_LOC=%d  IC_POS=%g  Idel=%g  t_therm=%d  celsius=%.1f\n", \
                    IC_LOC, IC_POS, Idel, t_therm, celsius)
    corr_out.printf("# Columnas: iamp[nA]  f_in_0[Hz]  f_in_1[Hz]  wi  f_out_0[Hz]  f_out_1[Hz]\n")
    print "Guardando en: ", new_file

    iamp_val = iamp_min
    while (iamp_val <= iamp_max + iamp_step/2) {
        iamp = iamp_val

        // PASO 1: f naturales sin inhibicion
        wi = 0
        min_spk = run_sim_clean()
        f_in_0 = 0  f_in_1 = 0
        if (spike_times[0].size() >= 2) {
            f_in_0 = (spike_times[0].size()-1) \
                   / (spike_times[0].x[spike_times[0].size()-1] \
                      - spike_times[0].x[0]) * 1000
        }
        if (spike_times[1].size() >= 2) {
            f_in_1 = (spike_times[1].size()-1) \
                   / (spike_times[1].x[spike_times[1].size()-1] \
                      - spike_times[1].x[0]) * 1000
        }
        print "iamp=", iamp_val, "nA  f_in_0=", f_in_0, " f_in_1=", f_in_1

        // PASO 2: f_out para cada wi
        wi_val = wi_min
        while (wi_val <= wi_max + wi_step/2) {
            wi = wi_val
            min_spk = run_sim_clean()
            f_out_0 = 0  f_out_1 = 0
            if (spike_times[0].size() >= 2) {
                f_out_0 = (spike_times[0].size()-1) \
                        / (spike_times[0].x[spike_times[0].size()-1] - spike_times[0].x[0]) * 1000
            }
            if (spike_times[1].size() >= 2) {
                f_out_1 = (spike_times[1].size()-1) \
                        / (spike_times[1].x[spike_times[1].size()-1] - spike_times[1].x[0]) * 1000
            }
            print "  wi=", wi_val, " f_out_0=", f_out_0, " f_out_1=", f_out_1
            corr_out.printf("%.6g %.6g %.6g %.6g %.6g %.6g\n", \
                iamp_val, f_in_0, f_in_1, wi_val, f_out_0, f_out_1)
            wi_val += wi_step
        }
        corr_out.printf("\n")
        corr_out.flush()
        iamp_val += iamp_step
    }
    corr_out.close()
    printf("Guardado en %s\n", new_file)
}

// ============================================================
// COMO LANZAR:
//   test_iamp_por_regimen()
//   freq_diagram()
// ============================================================
// ============================================================
// phase_diagram_compare()
// ============================================================
proc phase_diagram_compare() { local wi_val, iamp_val, n, min_spk, \
    csum1, csum2, csum1_sq, csum2_sq, cval1, cval2, sigma1, sigma2, \
    Nexp_actual, cv, c2
    iamp_min   = 0
	iamp_max   = 2.0
	iamp_step  = 0.02           // 36 iamps
	wi_min     = 0
	wi_max     = 5e-3           
	wi_step    = 2e-4           // 50 wi
	tstop_diag = 2000
	Idel       = 30
    Nexp = 1
    sprint(new_file, "Correlacion_TreeDend_IClamp_iamp_vs_wi_IC_LOC%d_ICPOS%g_Idel%g_therm%d_2Lanzada_Timida.txt", \
           IC_LOC, IC_POS, Idel, t_therm)
    corr_out = new File()
    corr_out.wopen(new_file)
    corr_out.printf("# TreeDend IClamp IC_LOC=%d  IC_POS=%g  Idel=%g  t_therm=%d\n", \
                    IC_LOC, IC_POS, Idel, t_therm)
    corr_out.printf("# Col: iamp  wi  C1  C2N  Pearson  Cseno\n")
    print "Guardando en: ", new_file
    iamp_val = iamp_min
    while (iamp_val <= iamp_max + iamp_step/2) {
        iamp = iamp_val
        print ">>> iamp =", iamp_val
        wi_val = wi_min
        while (wi_val <= wi_max + wi_step/2) {
            wi = wi_val
            min_spk = run_sim_clean()
            print "  wi=", wi_val, " spk0=", spike_times[0].size(), " spk1=", spike_times[1].size()
            cval1=0  cval2=0
            Nexp_actual = 0
            if (min_spk >= 5) {
                csum1=0  csum2=0
                for n = 1, Nexp {
                    min_spk = run_sim_clean()
                    if (min_spk >= 5) {
                        c2 = calc_corr_2_N()
                        calc_phase()
                        cv = calc_corr()
                        csum1 += cv
                        csum2 += c2
                        Nexp_actual += 1
                    }
                }
                if (Nexp_actual > 0) {
                    cval1 = csum1/Nexp_actual
                    cval2 = csum2/Nexp_actual
                    print "  -> C1=", cval1, " C2N=", cval2
                }
            }
            corr_out.printf("%.6g %.6g %.6g %.6g 0 0\n", iamp_val, wi_val, cval1, cval2)
            wi_val += wi_step
        }
        corr_out.printf("\n")
        corr_out.flush()
        iamp_val += iamp_step
    }
    corr_out.close()
    printf("Guardado en %s\n", new_file)
}

// ============================================================
// PASADA INICIAL
// ============================================================
tvec = new Vector()
tvec.record(&t)
for k = 0, 1 {
    vvec[k] = new Vector()
    soma[k] vvec[k].record(&v(0.5))
}
sprint(new_file, "Trayectorias_TreeDend_IClamp_iamp%g_wi%g_IC_LOC%d.txt", iamp, wi, IC_LOC)
fv = new File()
fv.wopen(new_file)
