// ============================================================
// 2cells_sinc_IClamp_clean.hoc
// Simulacion IClamp puro: diagrama iamp vs wi
// Con tiempo de termalizacion t_therm
// ============================================================

load_file("nrngui.hoc")
load_file("2cells.hoc")

// --- Canales ionicos y propiedades pasivas ---
forall insert pas
forall insert kdr
forall insert nax

forall g_pas = 0.0001
forall e_pas  = -65      // potencial de fuga = potencial de reposo
forall ena    = 55       // potencial de inversion del Na (mV)
forall ek     = -90      // potencial de inversion del K  (mV)

// Conductancias (valores tipicos Migliore para soma)
forall gbar_nax   = 0.04    // S/cm2  -- sube desde 0.01 default
forall gkdrbar_kdr = 0.04   // S/cm2  -- sube desde 0.003 default

celsius = 34
PI      = 3.14159265358979

// --- Parametros globales ---
iamp     = 0.042
iampfact = 1
wi       = 8e-6
Idel     = 30
N        = 2
t_therm  = 100   // ms de termalizacion antes de registrar datos

// --- Variables de archivo de voltaje (usada por advance) ---
objref fv
fv = new File()    // objeto vacio; advance() comprueba isopen()

// --- Objetos de registro ---
objref spike_times[2], spike_rec[2], vvec[2], tvec
objref nullobj

// --- Sinapsis inhibitorias reciprocas ---
objref syni[2], nci[2], ic[2]
objref phi[2], corr_out
objref ispk, tspkprec, tspknext, ph
strdef new_file

// ============================================================
// INICIALIZACION DE SOMAS
// ============================================================
for k = 0, 1 {
    soma[k] {
        syni[k]     = new ExpSyn(0.5)
        syni[k].tau = 30
        syni[k].e   = -80

        ic[k]       = new IClamp(0.5)
        ic[k].dur   = 0       // se setea en run_sim_clean()
        ic[k].del   = 0
        ic[k].amp   = iamp

        spike_times[k] = new Vector()
        spike_rec[k]   = new NetCon(&v(0.5), nullobj, 0, 0, 0)
        spike_rec[k].record(spike_times[k])
    }
}

for k = 0, 1 {
    m = k+1
    if (k == 1) m = 0
    soma[k] nci[k] = new NetCon(&v(.5), syni[m], 0, 0, wi)
}

// Diagnostico inmediatamente despues del bucle
for k = 0, 1 {
    m = k+1
    if (k == 1) m = 0
    print "nci[", k, "]: source=soma[", k, "].v  target=syni[", m, "]  weight=", nci[k].weight, "  delay=", nci[k].delay
    soma[k] print "  V_source actual=", v(0.5)
    soma[m] print "  syni[", m, "].e=", syni[m].e, "  tau=", syni[m].tau
}

// ============================================================
// advance(): escribe voltaje si fv esta abierto
// ============================================================
proc advance() {
    fadvance()
    if (fv.isopen()) {
        fv.printf("%g %g %g \n", t, soma[0].v, soma[1].v)
    }
}

// ============================================================
// run_sim_clean(): configura IClamps, graba y corre
// Incluye t_therm ms de termalizacion al inicio
// Devuelve el minimo de spikes entre los dos somas (post-therm)
// ============================================================
func run_sim_clean() { local k, min_spk, m, first_valid, t_idx
    if (fv.isopen()) { fv.close() }

    // Duracion total = termalizacion + simulacion util
    ic[0].amp = iamp
    ic[0].del = 0
    ic[0].dur = t_therm + tstop_diag
    ic[1].amp = iamp * iampfact
    ic[1].del = Idel
    ic[1].dur = t_therm + tstop_diag

    for k = 0, 1 {
        m = k + 1
        if (k == 1) { m = 0 }
        soma[k] nci[k] = new NetCon(&v(.5), syni[m], 0, 0, wi)
    }

    // Reiniciar vectores de registro
    tvec = new Vector()
    tvec.record(&t)
    for k = 0, 1 {
        spike_times[k] = new Vector()
        vvec[k]        = new Vector()
        soma[k] {
            vvec[k].record(&v(0.5))
            spike_rec[k] = new NetCon(&v(0.5), nullobj, 0, 0, 0)
            spike_rec[k].record(spike_times[k])
        }
    }

    finitialize(-65)
    tstop = t_therm + tstop_diag
    run()

    // --- Recortar tvec y vvec: quedarse solo con t >= t_therm ---
    t_idx = tvec.indwhere(">=", t_therm)
    if (t_idx > 0) {
        tvec.remove(0, t_idx - 1)
        for k = 0, 1 { vvec[k].remove(0, t_idx - 1) }
    }

    // --- Recortar spike_times: quedarse solo con spikes >= t_therm ---
    for k = 0, 1 {
        first_valid = spike_times[k].indwhere(">=", t_therm)
        if (first_valid > 0) {
            spike_times[k].remove(0, first_valid - 1)
        } else if (first_valid < 0) {
            // No hay ningun spike post-termalizacion: vaciar el vector
            spike_times[k].resize(0)
        }
    }

    min_spk = spike_times[0].size()
    if (spike_times[1].size() < min_spk) { min_spk = spike_times[1].size() }
    return min_spk
}

// ============================================================
// calc_phase(): fase de cada soma entre spikes consecutivos
// ============================================================
proc calc_phase() { local k, i, j, t_curr, t_prev, t_next
    for k = 0, 1 {
        phi[k] = new Vector(tvec.size())
        phi[k].fill(-1)
        for j = 0, tvec.size()-1 {
            t_curr = tvec.x[j]
            for i = 0, spike_times[k].size()-2 {
                if (t_curr >= spike_times[k].x[i] && t_curr < spike_times[k].x[i+1]) {
                    t_prev = spike_times[k].x[i]
                    t_next = spike_times[k].x[i+1]
                    phi[k].x[j] = 2*PI * (t_curr - t_prev) / (t_next - t_prev)
                }
            }
        }
    }
}

// ============================================================
// calc_corr(): C1 - correlacion coseno de fase
// ============================================================
func calc_corr() { local j, tin_idx, tfin_idx, sum, dt, t_range, dphi
    tin_idx  = tvec.indwhere(">=", spike_times[0].x[1])
    tfin_idx = tvec.indwhere(">=", spike_times[0].x[spike_times[0].size()-2])
    if (tin_idx  < 0) { tin_idx  = 0 }
    if (tfin_idx < 0) { tfin_idx = tvec.size()-1 }
    t_range = tvec.x[tfin_idx] - tvec.x[tin_idx]
    if (t_range <= 0) { return -9999 }
    sum = 0
    dt  = tvec.x[1] - tvec.x[0]
    for j = tin_idx, tfin_idx-1 {
        if (phi[0].x[j] >= 0 && phi[1].x[j] >= 0) {
            dphi = phi[1].x[j] - phi[0].x[j]
            sum  = sum + cos(dphi) * dt
        }
    }
    return sum / t_range
}

// ============================================================
// calc_corr_2_N(): C2N - metodo de fase continua
// ============================================================
func calc_corr_2_N() { local l, tmax, ttt, ddt, cs_med, t_range
    ispk     = new Vector(N)
    tspkprec = new Vector(N)
    tspknext = new Vector(N)
    ph       = new Vector(N)

    tmax = spike_times[0].x[spike_times[0].size()-1]
    for l = 1, N-1 {
        if (spike_times[l].x[spike_times[l].size()-1] < tmax) {
            tmax = spike_times[l].x[spike_times[l].size()-1]
        }
    }

    ddt = 0.1
    for l = 0, N-1 {
        ispk.x[l]     = 0
        tspkprec.x[l] = spike_times[l].x[0]
        tspknext.x[l] = spike_times[l].x[1]
        ph.x[l]       = 0
    }

    cs_med  = 0
    ttt     = tvec.x[0]
    while (ttt < tmax) {
        for l = 0, N-1 {
            if (spike_times[l].size() > 1) {
                if (ttt >= tspknext.x[l]) {
                    if (ispk.x[l] + 1 < spike_times[l].size() - 1) {
                        ispk.x[l]     = ispk.x[l] + 1
                        tspkprec.x[l] = spike_times[l].x[ispk.x[l]]
                        tspknext.x[l] = spike_times[l].x[ispk.x[l] + 1]
                    }
                }
                if (tspkprec.x[l] != tspknext.x[l]) {
                    ph.x[l] = 0
                    if (ttt < tspknext.x[l]) {
                        ph.x[l] = 2*PI * (ttt - tspkprec.x[l]) / (tspknext.x[l] - tspkprec.x[l])
                    }
                }
            }
        }
        cs_med = cs_med + cos(ph.x[1] - ph.x[0]) * ddt
        ttt    = ttt + ddt
    }
    t_range = ttt - tvec.x[0]
    if (t_range <= 0) { return -9999 }
    return cs_med / t_range
}

// ============================================================
// calc_pearson(): correlacion de Pearson entre voltajes
// ============================================================
func calc_pearson() { local j, mean0, mean1, sum0, sum1, num, den0, den1
    sum0 = 0   sum1 = 0
    for j = 0, tvec.size()-1 {
        sum0 = sum0 + vvec[0].x[j]
        sum1 = sum1 + vvec[1].x[j]
    }
    mean0 = sum0 / tvec.size()
    mean1 = sum1 / tvec.size()
    num = 0   den0 = 0   den1 = 0
    for j = 0, tvec.size()-1 {
        num  = num  + (vvec[0].x[j]-mean0) * (vvec[1].x[j]-mean1)
        den0 = den0 + (vvec[0].x[j]-mean0) * (vvec[0].x[j]-mean0)
        den1 = den1 + (vvec[1].x[j]-mean1) * (vvec[1].x[j]-mean1)
    }
    if (den0 <= 0 || den1 <= 0) { return 0 }
    return num / sqrt(den0 * den1)
}

// ============================================================
// calc_corr_seno(): correlacion seno de fase
// ============================================================
func calc_corr_seno() { local j, tin_idx, tfin_idx, sum, dt, t_range, dphi
    tin_idx  = tvec.indwhere(">=", spike_times[0].x[1])
    tfin_idx = tvec.indwhere(">=", spike_times[0].x[spike_times[0].size()-2])
    if (tin_idx  < 0) { tin_idx  = 0 }
    if (tfin_idx < 0) { tfin_idx = tvec.size()-1 }
    t_range = tvec.x[tfin_idx] - tvec.x[tin_idx]
    if (t_range <= 0) { return -9999 }
    sum = 0
    dt  = tvec.x[1] - tvec.x[0]
    for j = tin_idx, tfin_idx-1 {
        if (phi[0].x[j] >= 0 && phi[1].x[j] >= 0) {
            dphi = phi[1].x[j] - phi[0].x[j]
            sum  = sum + sin(dphi) * dt
        }
    }
    return sum / t_range
}

// ============================================================
// freq_diagram(): barrido iamp vs wi -> frecuencia de salida
// ============================================================
proc freq_diagram() { local wi_val, iamp_val, min_spk, \
                           f_in_0, f_in_1, f_out_0, f_out_1
    iamp_min  = 0.038
    iamp_max  = 0.050
    iamp_step = 0.001

    wi_min    = 2e-6
    wi_max    = 1e-4
    wi_step   = 2e-6

    tstop_diag = 4000

    sprint(new_file, "FreqIn_vs_FreqOut_Idel%g_therm%d_fino.txt", Idel, t_therm)
    corr_out = new File()
    corr_out.wopen(new_file)
    corr_out.printf("# iamp  f_in_0[Hz]  f_in_1[Hz]  wi  f_out_0[Hz]  f_out_1[Hz]\n")
    print "Guardando en: ", new_file

    iamp_val = iamp_min
    while (iamp_val <= iamp_max + iamp_step/2) {
        iamp = iamp_val

        // --- PASO 1: frecuencias de entrada, cada soma aislado (wi=0) ---
        wi = 0
        min_spk = run_sim_clean()

        f_in_0 = 0
        f_in_1 = 0
        if (spike_times[0].size() >= 2) {
            f_in_0 = (spike_times[0].size()-1) \
                   / (spike_times[0].x[spike_times[0].size()-1] \
                      - spike_times[0].x[0]) * 1000
        }
        if (spike_times[1].size() >= 2) {
            f_in_1 = (spike_times[1].size()-1) \
                   / (spike_times[1].x[spike_times[1].size()-1] \
                      - spike_times[1].x[0]) * 1000
        }
        print "iamp=", iamp_val, \
              "  f_in_0=", f_in_0, " Hz", \
              "  f_in_1=", f_in_1, " Hz"

        // --- PASO 2: frecuencias de salida para cada wi ---
        wi_val = wi_min
        while (wi_val <= wi_max + wi_step/2) {
            wi = wi_val
            min_spk = run_sim_clean()
            f_out_0 = 0
            f_out_1 = 0
            if (spike_times[0].size() >= 2) {
                f_out_0 = (spike_times[0].size()-1) / (spike_times[0].x[spike_times[0].size()-1] - spike_times[0].x[0]) * 1000
            }
            if (spike_times[1].size() >= 2) {
                f_out_1 = (spike_times[1].size()-1) / (spike_times[1].x[spike_times[1].size()-1] - spike_times[1].x[0]) * 1000
            }

            print "  wi=", wi_val, \
                  "  f_out_0=", f_out_0, " Hz", \
                  "  f_out_1=", f_out_1, " Hz"

            corr_out.printf("%.6g %.6g %.6g %.6g %.6g %.6g\n", \
                iamp_val, f_in_0, f_in_1, wi_val, f_out_0, f_out_1)

            wi_val += wi_step
        }
        corr_out.printf("\n")
        iamp_val += iamp_step
    }
    corr_out.close()
    printf("Guardado en %s\n", new_file)
}

// ============================================================
// phase_diagram_compare(): bucle principal iamp vs wi
// ============================================================
proc phase_diagram_compare() { local wi_val, iamp_val, k, n, \
    min_spk, csum1, csum2, csum3, csum4, \
    cval1, cval2, cval3, cval4, Nexp_actual, cv, c2, cp, cs

    // --- Rangos ---
    iamp_min  = 0.038
    iamp_max  = 0.05
    iamp_step = 0.001
    wi_min    = 1e-5
    wi_max    = 8e-5
    wi_step   = 1e-6
    tstop_diag = 4000   // mas tiempo para asegurar regimen estacionario
    Nexp       = 1

    sprint(new_file, "Correlacion_iamp_vs_wi_IClamp_Freq_Fases_Idel%g_Termalizacion_%d_Simulacion_wiCritico.txt", Idel, t_therm)
    corr_out = new File()
    corr_out.wopen(new_file)
    corr_out.printf("# iamp wi C1 C2N Pearson Cseno\n")
    print "Guardando en: ", new_file

    iamp_val = iamp_min
    while (iamp_val <= iamp_max + iamp_step/2) {
        iamp = iamp_val
        print ">>> iamp =", iamp_val

        wi_val = wi_min
        while (wi_val <= wi_max + wi_step/2) {
            wi = wi_val
            min_spk = run_sim_clean()
            print "  wi=", wi_val, " spikes0=", spike_times[0].size(), " spikes1=", spike_times[1].size(), " (post-therm)\n"

            cval1=0  cval2=0  cval3=0  cval4=0
            Nexp_actual = 0

            if (min_spk >= 5) {
                csum1=0  csum2=0  csum3=0  csum4=0
                for n = 1, Nexp {
                    min_spk = run_sim_clean()
                    if (min_spk >= 5) {
                        c2 = calc_corr_2_N()
                        calc_phase()
                        cv = calc_corr()
                        cp = calc_pearson()
                        cs = calc_corr_seno()
                        csum1 += cv
                        csum2 += c2
                        csum3 += cp
                        csum4 += cs
                        Nexp_actual += 1
                    }
                }
                if (Nexp_actual > 0) {
                    cval1 = csum1 / Nexp_actual
                    cval2 = csum2 / Nexp_actual
                    cval3 = csum3 / Nexp_actual
                    cval4 = csum4 / Nexp_actual
                    print "C1=", cval1, "C2=", cval2, "C3=", cval3, "C4=", cval4
                }
            } else {
                print "  SIN SPIKES suficientes (post-therm): iamp=", iamp_val, " wi=", wi_val
            }

            corr_out.printf("%.6g %.6g %.6g %.6g %.6g %.6g\n", \
                iamp_val, wi_val, cval1, cval2, cval3, cval4)

            wi_val += wi_step
        }
        corr_out.printf("\n")
        iamp_val += iamp_step
    }
    corr_out.close()
    printf("Guardado en %s\n", new_file)
}

// ============================================================
// snippet_barrido_size_iclamp.hoc
// ------------------------------------------------------------
// Anadir al final de 2cells_sinc_IClamp_clean.hoc.
//
// Barrido del tamano (L y diam) del soma. Para cada factor:
//   - Fija iamp = 0.044 nA (umbral, donde mejor se ve la transicion)
//   - Hace barrido 1D en wi
//   - Calcula <C> con calc_corr y calc_corr_2_N
//   - Guarda fichero independiente
//
// Las conductancias en S/cm2 (g_pas, gbar_nax, gkdrbar_kdr) se
// mantienen iguales, asi que al cambiar L y diam la conductancia
// TOTAL escala con el area. Para una iamp fija eso cambia la
// excitabilidad efectiva del soma.
//
// Tiempo estimado: 4 tamanos x ~50 wi x ~5s/sim = ~15 min.
// ============================================================

// ============================================================
// barrido_size_run(factor):
//   Aplica L = diam = 5*factor a ambos somas y hace el barrido en wi.
//   Asume que la geometria original es L = diam = 5 um.
// ============================================================
proc barrido_size_run() { local factor, wi_val, min_spk, cv, c2, k   localobj fout
    factor = $1

    // Cambiar geometria de los dos somas
    for k = 0, 1 {
        soma[k] {
            L    = 5 * factor
            diam = 5 * factor
        }
    }

    sprint(new_file, "Correlacion_wi_IClamp_iamp%g_Idel%g_sizefactor%g.txt", \
           iamp, Idel, factor)
    fout = new File()
    fout.wopen(new_file)
    fout.printf("# iamp=%g  Idel=%g  size_factor=%g  L=%g  diam=%g  t_therm=%d\n", \
                iamp, Idel, factor, 5*factor, 5*factor, t_therm)
    fout.printf("# wi  C1  C2N\n")
    print "==> ", new_file

    wi_val = wi_min
    while (wi_val <= wi_max + wi_step/2) {
        wi = wi_val
        min_spk = run_sim_clean()

        cv = 0
        c2 = 0
        if (min_spk >= 5) {
            c2 = calc_corr_2_N()
            calc_phase()
            cv = calc_corr()
        }
        fout.printf("%.6g\t%.6g\t%.6g\n", wi_val, cv, c2)
        print "  factor=", factor, "  wi=", wi_val, "  C2N=", c2

        wi_val += wi_step
    }
    fout.close()
    printf("Guardado: %s\n", new_file)
}

// ============================================================
// barrido_size():
//   Driver. Recorre los 4 tamanos. La configuracion fija es:
//     iamp = 0.044 nA (umbral)
//     Idel = 30 ms
//     wi en [0, 1e-4] paso 2e-6
// ============================================================
proc barrido_size() {
    // Configuracion fija
    iamp       = 0.044       // UMBRAL (mejor transicion visible)
    Idel       = 30
    tstop_diag = 4000
    wi_min     = 0
    wi_max     = 1e-4
    wi_step    = 2e-6

    barrido_size_run(0.5)    // mini      = 2.5 um
    barrido_size_run(1.0)    // original  = 5.0 um
    barrido_size_run(2.0)    // doble     = 10  um
    barrido_size_run(4.0)    // cuadruple = 20  um
}

// ============================================================
// snippet_barrido_tauinh_iclamp.hoc
// ------------------------------------------------------------
// Anadir al final de 2cells_sinc_IClamp_clean.hoc.
//
// Barrido del tau de la sinapsis INHIBITORIA (syni, ExpSyn).
// Para cada valor de tau_inh:
//   - Fija iamp = 0.044 nA (umbral, donde mejor se ve la transicion)
//   - Hace barrido 1D en wi
//   - Calcula <C> con calc_corr y calc_corr_2_N
//   - Guarda fichero independiente
//
// La sinapsis inhibitoria es ExpSyn -> solo tiene UN tau.
// Original: syni[k].tau = 30 ms.
//
// Tiempo estimado: 6 valores x ~50 wi x ~5s/sim = ~25 min.
// ============================================================

proc barrido_tauinh_run() { local tau_inh, wi_val, min_spk, cv, c2   localobj fout
    tau_inh = $1

    // Aplicar tau a la sinapsis INHIBITORIA
    syni[0].tau = tau_inh
    syni[1].tau = tau_inh

    sprint(new_file, "Correlacion_wi_IClamp_iamp%g_Idel%g_tauinh_%g.txt", \
           iamp, Idel, tau_inh)
    fout = new File()
    fout.wopen(new_file)
    fout.printf("# iamp=%g  Idel=%g  tau_inh=%g  t_therm=%d\n", \
                iamp, Idel, tau_inh, t_therm)
    fout.printf("# wi  C1  C2N\n")
    print "==> ", new_file

    wi_val = wi_min
    while (wi_val <= wi_max + wi_step/2) {
        wi = wi_val
        min_spk = run_sim_clean()

        cv = 0
        c2 = 0
        if (min_spk >= 5) {
            c2 = calc_corr_2_N()
            calc_phase()
            cv = calc_corr()
        }
        fout.printf("%.6g\t%.6g\t%.6g\n", wi_val, cv, c2)
        print "  tau_inh=", tau_inh, "  wi=", wi_val, "  C2N=", c2

        wi_val += wi_step
    }
    fout.close()
    printf("Guardado: %s\n", new_file)
}

proc barrido_tauinh() {
    // Configuracion fija
    iamp       = 0.044         // UMBRAL
    Idel       = 30
    tstop_diag = 4000
    wi_min     = 0
    wi_max     = 1e-4
    wi_step    = 2e-6

    // Barrido de tau_inh (ms). Original: 30 ms.
    barrido_tauinh_run(5)
    barrido_tauinh_run(10)
    barrido_tauinh_run(20)
    barrido_tauinh_run(30)       // original
    barrido_tauinh_run(50)
    barrido_tauinh_run(100)
}


//load_file("Ses_2c_sinc.ses")

tvec = new Vector()
tvec.record(&t)

for k = 0, 1 {
    vvec[k] = new Vector()
    soma[k] vvec[k].record(&v(0.5))
}

// Abrir archivo de voltaje para la pasada inicial (la ve la GUI)
sprint(new_file, "Trayectorias_Iamp_%g_wi_%g.txt", iamp, wi)
fv = new File()
fv.wopen(new_file)
fv.printf("# t    soma[0].v, soma[1].v  \n")

ic[0].amp = iamp
ic[0].del = 0
ic[0].dur = t_therm + 3000
ic[1].amp = iamp * iampfact
ic[1].del = Idel
ic[1].dur = t_therm + 3000

tstop = t_therm + 3000
run()
fv.close()

// --- Diagrama principal ---
tstop_diag = 5000

